{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pronunciation-coach",
  "main": "src/index.ts",
  // Must not be newer than the date the test runtime supports (see docs/technical-design.md).
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  // The PWA build (apps/pwa/dist) is served as static assets. API paths reach the Worker first;
  // any other unknown path returns index.html so the app can handle it.
  "assets": {
    "directory": "../pwa/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pronunciation-coach",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
